<Application x:Class="WebTaddy.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WebTaddy">
    <Application.Resources>


        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MantisUI;component/MantisUI.xaml"/>

                <ResourceDictionary Source="Resources/Dictionaries/Buttons.xaml"/>
                <ResourceDictionary Source="Resources/Dictionaries/Converters.xaml"/>
                <ResourceDictionary Source="Resources/Dictionaries/Images.xaml"/>
                <ResourceDictionary Source="Resources/Dictionaries/Palette.xaml"/>
                <ResourceDictionary Source="Resources/Dictionaries/TextControls.xaml"/>
                <ResourceDictionary Source="Resources/Dictionaries/Typography.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
         
    </Application.Resources>
</Application>
